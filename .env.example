# -----------------------------------------------------------------------------
# Local development environment. Copy to `.env` (never commit `.env`):
#     Copy-Item .env.example .env        (PowerShell)
#     cp .env.example .env               (bash)
#
# Every value here is a LOCAL-ONLY placeholder. The API refuses to start with
# APP_ENV=production while any URL still contains "change-me".
# Host-side URLs use 127.0.0.1, not "localhost": on Windows "localhost" resolves to ::1
# first and Docker publishes on IPv4 only, which stalls DB/Redis clients. Docker compose
# rewrites them to service names (postgres, redis, api) for containers.
# -----------------------------------------------------------------------------

# --- Postgres (docker compose) ----------------------------------------------
POSTGRES_DB=chatbot
# Schema owner: runs migrations only.
POSTGRES_USER=platform_owner
POSTGRES_PASSWORD=change-me-local-owner
# Runtime role used by the API and workers (no superuser, no BYPASSRLS).
POSTGRES_APP_USER=platform_app
POSTGRES_APP_PASSWORD=change-me-local-app

# Host ports (change if something else already uses them). Postgres defaults to 55432
# so it never collides with a natively installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# --- API / worker ------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# console (human-friendly) or json (deployed environments)
LOG_FORMAT=console
DATABASE_URL=postgresql+psycopg://platform_app:change-me-local-app@127.0.0.1:55432/chatbot
MIGRATION_DATABASE_URL=postgresql+psycopg://platform_owner:change-me-local-owner@127.0.0.1:55432/chatbot
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# Comma-separated browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies allowed to set X-Forwarded-For/-Proto: exact IPs or CIDRs, comma-separated.
# Leave empty unless a proxy sits in front of the API. Wildcards and /0 are refused.
FORWARDED_ALLOW_IPS=
# Base URL of the web app, used for links in emails (verify email, reset password, invitations).
WEB_BASE_URL=http://localhost:3000

# --- Email ---------------------------------------------------------------------
# `smtp` sends through SMTP (Mailpit locally: UI at http://localhost:8025). `log` prints whole
# messages, including token links, to the API log; development only (production refuses it).
EMAIL_BACKEND=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025

# --- Object storage (uploaded originals) ----------------------------------------
# S3-compatible API. Locally Docker Compose runs RustFS on port 9000 (host-side URL below).
# The bucket is private; it is created by the `storage-init` service (python -m app.cli init-storage).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=acs-documents
S3_ACCESS_KEY=platform_storage
S3_SECRET_KEY=change-me-local-storage
STORAGE_HOST_PORT=9000

# --- Embeddings --------------------------------------------------------------------
# `hash` = deterministic offline baseline for development/tests (lexical only, refused in
# production). For real retrieval quality use `openai_compatible` with a key.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-v1
# HTTPS for both AI adapters by default; staging/production always require it.
# Explicit local/test-only exception for localhost, 127.0.0.0/8 or [::1] HTTP fixtures.
# Does NOT permit container service names, LAN addresses, redirects or insecure TLS.
ALLOW_INSECURE_LOCAL_PROVIDERS=false
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# Ingestion limits and chunking: see docs/INGESTION.md §5 for every tunable.

# --- Web (Next.js) -----------------------------------------------------------
# How the Next.js *server* reaches the API (compose overrides this to http://api:8000).
API_INTERNAL_URL=http://127.0.0.1:8000
# How *browsers* reach the API (inlined into the client bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Phase 5: choose disabled (default), demo (offline fixture), or openai_compatible.
# demo exercises transport only; it is not a real AI model and is refused in production.
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=2
CHAT_CONTEXT_MESSAGES=12
CHAT_INPUT_TOKEN_BUDGET=16000
CHAT_MIN_VECTOR_SCORE=0.15
CHAT_REQUESTS_PER_MINUTE=60
CHAT_CONCURRENCY_PER_ORG=3
DB_POOL_TIMEOUT_SECONDS=2
CHAT_SETUP_CAPACITY=8
CHAT_ADMISSION_WAIT_SECONDS=0.9
CHAT_MONTHLY_TOKEN_LIMIT=2000000
CHAT_MONTHLY_COST_LIMIT_USD=25
# Operator-maintained estimates per million input/output tokens; verify for your provider.
CHAT_MODEL_PRICES={"gpt-4.1-mini":[0.40,1.60],"gpt-4.1-nano":[0.10,0.40],"gpt-4.1":[2.0,8.0]}
WIDGET_SESSION_MINUTES=15
WIDGET_MESSAGES_PER_SESSION=30

# --- Document parsing and ingestion limits (docs/INGESTION.md) -------------------
# Every parse runs in its own child process under these limits (enforced on Linux).
# PARSER_WALL_SECONDS=60
# PARSER_CPU_SECONDS=30
# PARSER_MEMORY_BYTES=536870912
# INGEST_SOFT_TIME_LIMIT_SECONDS=120
# INGEST_HARD_TIME_LIMIT_SECONDS=180
# CRAWL_MAX_TASK_SECONDS=3300
# INGEST_MAX_ACTIVE_PER_ORG=1
# INGEST_STUCK_AFTER_SECONDS=900
# INGEST_SWEEP_INTERVAL_SECONDS=120
# Worker container limits (docker compose), sized for two concurrent tasks.
# WORKER_MEMORY_LIMIT=2g
# WORKER_CPUS=2
# WORKER_PIDS_LIMIT=128
# MAINTENANCE_MEMORY_LIMIT=512m
