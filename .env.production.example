# -----------------------------------------------------------------------------
# Production environment for the Contabo VPS. On the server:
#     cp .env.production.example .env.production && chmod 600 .env.production
# Generate each secret with:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# NEVER commit .env.production. The API refuses to start in production if any
# database/redis URL still contains "change-me".
# -----------------------------------------------------------------------------

# --- Public address (free DuckDNS name pointing at the VPS IP) -----------------
SITE_HOST=yourname.duckdns.org
ACME_EMAIL=you@example.com

# --- Postgres -------------------------------------------------------------------
POSTGRES_DB=chatbot
POSTGRES_USER=platform_owner
POSTGRES_PASSWORD=
POSTGRES_APP_USER=platform_app
POSTGRES_APP_PASSWORD=

# --- Object storage (internal RustFS) -------------------------------------------
S3_BUCKET=acs-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Email (required: password resets, verification, invitations) ---------------
# Any SMTP provider works (Brevo, Resend, Mailgun, Gmail app password, ...).
EMAIL_FROM=Support Platform <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- AI providers (required: hash/demo providers are refused in production) -----
# Example: Google Gemini through its OpenAI-compatible API.
# The database column is vector(1536); keep embeddings at 1536 dimensions.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_API_KEY=
CHAT_MODEL_PRICES={"gemini-3.5-flash":[0.30,2.50],"gemini-3.5-flash-lite":[0.10,0.40]}

# --- Trusted reverse proxy (see docs/DEPLOY_CONTABO.md, "Trusted ingress") ------
# Exact IP address or CIDR of the proxy in front of the API. Wildcards and /0 are refused.
# Empty trusts no proxy: all visitors then share the proxy's address in IP rate limits.
FORWARDED_ALLOW_IPS=

# --- Tuning ----------------------------------------------------------------------
LOG_LEVEL=INFO
WORKER_CONCURRENCY=2
CHAT_MONTHLY_TOKEN_LIMIT=2000000
CHAT_MONTHLY_COST_LIMIT_USD=25

# --- Document parsing and ingestion limits (docs/INGESTION.md) -------------------
# Every parse runs in its own child process under these limits (enforced on Linux).
# PARSER_WALL_SECONDS=60
# PARSER_CPU_SECONDS=30
# PARSER_MEMORY_BYTES=536870912
# INGEST_SOFT_TIME_LIMIT_SECONDS=120
# INGEST_HARD_TIME_LIMIT_SECONDS=180
# CRAWL_MAX_TASK_SECONDS=3300
# INGEST_MAX_ACTIVE_PER_ORG=1
# INGEST_STUCK_AFTER_SECONDS=900
# INGEST_SWEEP_INTERVAL_SECONDS=120
# Worker container limits (docker compose), sized for two concurrent tasks.
# WORKER_MEMORY_LIMIT=2g
# WORKER_CPUS=2
# WORKER_PIDS_LIMIT=128
# The one-slot recovery worker (docs/INGESTION.md).
# MAINTENANCE_MEMORY_LIMIT=512m
