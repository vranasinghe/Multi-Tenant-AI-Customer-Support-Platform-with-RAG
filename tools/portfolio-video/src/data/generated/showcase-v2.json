  "captions": [
    {
      "start": 0.35,
      "end": 1.616,
      "text": "One platform."
    },
    {
      "start": 1.636,
      "end": 3.329,
      "text": "Multiple businesses."
    },
    {
      "start": 3.349,
      "end": 6.957,
      "text": "Customer support grounded in each\norganization's own knowledge."
    },
    {
      "start": 7.883,
      "end": 11.749,
      "text": "This is a multi-tenant AI customer support\nplatform."
    },
    {
      "start": 11.769,
      "end": 13.611,
      "text": "Each business gets a dashboard,"
    },
    {
      "start": 13.851,
      "end": 15.448,
      "text": "a guided chatbot setup,"
    },
    {
      "start": 15.688,
      "end": 16.799,
      "text": "a knowledge base,"
    },
    {
      "start": 17.039,
      "end": 18.711,
      "text": "an embeddable chat widget,"
    },
    {
      "start": 18.951,
      "end": 20.46,
      "text": "and a shared team inbox."
    },
    {
      "start": 21.617,
      "end": 25.213,
      "text": "Documents are processed in the background,\nfrom queued to ready."
    },
    {
      "start": 25.517,
      "end": 27.578,
      "text": "Answers carry their sources."
    },
    {
      "start": 27.598,
      "end": 32.272,
      "text": "This demo reply is a fixed sentence, but\nthe retrieval behind it is real."
    },
    {
      "start": 32.512,
      "end": 35.077,
      "text": "A second business cannot open this\nworkspace."
    },
    {
      "start": 35.317,
      "end": 38.565,
      "text": "A visitor's conversation survives a page\nreload."
    },
    {
      "start": 38.805,
      "end": 40.897,
      "text": "Analytics come from recorded events,"
    },
    {
      "start": 42.092,
      "end": 44.648,
      "text": "and installing the widget twice still\nkeeps one."
    },
    {
      "start": 46.283,
      "end": 48.137,
      "text": "Underneath are four layers."
    },
    {
      "start": 48.157,
      "end": 49.675,
      "text": "The experience layer:"
    },
    {
      "start": 49.695,
      "end": 51.038,
      "text": "dashboard and widget."
    },
    {
      "start": 51.278,
      "end": 54.233,
      "text": "The application layer, built on FastAPI."
    },
    {
      "start": 54.473,
      "end": 56.514,
      "text": "Data and background processing."
    },
    {
      "start": 56.754,
      "end": 58.224,
      "text": "And RAG intelligence."
    },
    {
      "start": 58.464,
      "end": 63.083,
      "text": "It is one modular monolith, running as\nseveral processes in containers."
    },
    {
      "start": 64.017,
      "end": 67.837,
      "text": "The first audit passed five hundred and\neighty-two backend tests,"
    },
    {
      "start": 67.857,
      "end": 69.313,
      "text": "and still found problems."
    },
    {
      "start": 69.553,
      "end": 74.303,
      "text": "Today the listed local suites report\nfifteen hundred and five passing tests."
    },
    {
      "start": 74.667,
      "end": 77.482,
      "text": "All seven audit findings pass locally,"
    },
    {
      "start": 77.502,
      "end": 81.969,
      "text": "and the self-audit score rose from eighty\nand a half to eighty-five point seven"
    },
    {
      "start": 81.989,
      "end": 82.543,
      "text": "five."
    },
    {
      "start": 82.783,
      "end": 84.646,
      "text": "These are local results."
    },
    {
      "start": 84.666,
      "end": 88.149,
      "text": "Real AI quality and production readiness\nare unproven."
    },
    {
      "start": 89.083,
      "end": 93.797,
      "text": "Software engineering, full-stack\ndevelopment and AI engineering."
    },
    {
      "start": 93.817,
      "end": 97.26,
      "text": "The full technical case study covers the\ndetails."
    },
    {
      "start": 97.28,
      "end": 99.645,
      "text": "The portfolio address is on screen."
    }
  ]
}
